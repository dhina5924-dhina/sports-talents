# Application Configuration
APP_NAME="Sports Platform"
DEBUG=True
SECRET_KEY="sports_platform_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database Configuration
# For MySQL: mysql+pymysql://username:password@localhost:3306/sports_db
# SQLite fallback is automatic if MySQL connection is not configured or unavailable.
DATABASE_URL="sqlite:///./sports_platform.db"

# Media Storage Configuration
STORAGE_PROVIDER="local"  # 'local', 's3', or 'cloudinary'
MEDIA_DIR="./uploads"
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=50

# Admin Defaults (Auto created on first run)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@sportsplatform.com"
ADMIN_PASSWORD="adminpassword123"
